# ==============================================================================
# ScamShield AI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ScamShield AI"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production-scamshield
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Field-Level Encryption Key (Fernet key for encrypting stored message history)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=dGhpc19pc19hX2R1bW15XzMyX2J5dGVfZmVybmV0X2tleV9mb3JfZGV2IQ==

# Database (PostgreSQL default, SQLite fallback for quick testing: sqlite+aiosqlite:///./scamshield.db)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scamshield
# Test / SQLite local fallback:
# DATABASE_URL=sqlite+aiosqlite:///./scamshield.db

# Redis Cache & Task Queue
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_ANONYMOUS_PER_MIN=15
RATE_LIMIT_AUTHENTICATED_PER_MIN=60

# External Threat Intelligence APIs (Optional: modules fall back to offline heuristics when missing)
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_KEY=
PHISHTANK_KEY=
SERPAPI_KEY=

# File Storage & Quarantine
UPLOAD_DIR=./uploads
QUARANTINE_DIR=./uploads/quarantine
MAX_FILE_SIZE_MB=10
FILE_RETENTION_HOURS=24

# Web Front End Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
