            "type": "number",
            "title": "Avg Latency Ms"
          },
          "adapter_health": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Adapter Health"
          }
        },
        "type": "object",
        "required": [
          "total_scans",
          "scans_last_24h",
          "threat_breakdown",
          "avg_latency_ms",
          "adapter_health"
        ],
        "title": "AdminMetrics"
      },
      "Body_create_scan_api_v1_scans_post": {
        "properties": {
          "payload": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScanCreateRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "file": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "File"
          },
          "text_form": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text Form"
          },
          "platform_form": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Platform Form"
          }
        },
        "type": "object",
        "title": "Body_create_scan_api_v1_scans_post"
      },
      "CommunityReportCreate": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind",
            "description": "phone, wallet, url, or username"
          },
          "indicator_value": {
            "type": "string",
            "title": "Indicator Value",
            "description": "The indicator value being reported"
          },
          "platform": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Platform",
            "default": "unknown"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "indicator_value"
        ],
        "title": "CommunityReportCreate"
      },
      "CommunityReportResponse": {
        "properties": {
          "reputation_id": {
            "type": "string",
            "title": "Reputation Id"
          },
          "report_count": {
            "type": "integer",
            "title": "Report Count"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "reputation_id",
          "report_count",
          "status",
          "message"
        ],
        "title": "CommunityReportResponse"
      },
      "Evidence": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Unique machine-readable reason identifier, e.g. URGENCY_LANGUAGE"
          },
          "severity": {
            "$ref": "#/components/schemas/SeverityLevel",
            "description": "Severity level: low, medium, high, or critical"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Short plain-English title"
          },
          "plain_text": {
            "type": "string",
            "title": "Plain Text",
            "description": "Clear explanation of the detected risk factor"
          },
          "source": {
            "$ref": "#/components/schemas/ScanSource",
            "description": "Origin of this evidence finding"
          },
          "span": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Span",
            "description": "Start and end character offsets in original text for inline highlighting"
          }
        },
        "type": "object",
        "required": [
          "code",
          "severity",
          "title",
          "plain_text",
          "source"
        ],
        "title": "Evidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
